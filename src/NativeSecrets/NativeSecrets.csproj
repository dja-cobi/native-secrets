<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- Базовый кроссплатформенный таргет (работает на Linux, Windows, macOS) -->
        <TargetFramework>net10.0</TargetFramework>

        <!-- Android включаем только если установлен Android SDK или передан флаг -p:EnableAndroid=true -->
        <TargetFrameworks Condition="'$(EnableAndroid)' == 'true'">$(TargetFrameworks);net10.0-android</TargetFrameworks>

        <!-- Windows-таргет подключается автоматически при сборке на Windows -->
        <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows</TargetFrameworks>

        <!-- Apple-таргеты подключаются автоматически при сборке на macOS (включая GitHub Actions macos-latest) -->
        <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">$(TargetFrameworks);net10.0-ios;net10.0-maccatalyst</TargetFrameworks>

        <!-- Основные настройки проекта -->
        <RootNamespace>NativeSecrets</RootNamespace>
        <AssemblyName>NativeSecrets</AssemblyName>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

        <!-- Совместимость с NativeAOT и Trimming (без PublishAot, так как это библиотека) -->
        <IsAotCompatible>true</IsAotCompatible>
        <IsTrimmable>true</IsTrimmable>
        <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
        <EnableAotAnalyzer>true</EnableAotAnalyzer>
        <InvariantGlobalization>true</InvariantGlobalization>

        <!-- Подавляем предупреждения о платформенно-зависимых API (вы проверяете ОС в рантайме) -->
        <NoWarn>$(NoWarn);CA1416</NoWarn>
    </PropertyGroup>

    <!-- Настройки для Windows -->
    <PropertyGroup Condition="$(TargetFramework.Contains('-windows'))">
        <UseWindowsForms>false</UseWindowsForms>
        <UseWPF>false</UseWPF>
    </PropertyGroup>

    <!-- Настройки для Android -->
    <PropertyGroup Condition="$(TargetFramework.Contains('-android'))">
        <SupportedOSPlatformVersion>21.0</SupportedOSPlatformVersion>
        <OutputType>Library</OutputType>
    </PropertyGroup>

    <!-- Настройки для iOS -->
    <PropertyGroup Condition="$(TargetFramework.Contains('-ios'))">
        <SupportedOSPlatformVersion>12.2</SupportedOSPlatformVersion>
        <OutputType>Library</OutputType>
    </PropertyGroup>

    <!-- Настройки для Mac Catalyst -->
    <PropertyGroup Condition="$(TargetFramework.Contains('-maccatalyst'))">
        <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
        <OutputType>Library</OutputType>
    </PropertyGroup>

    <PropertyGroup>
        <PackageId>NativeSecrets</PackageId>
        <Version>1.0.0</Version>
        <Authors>djacobi</Authors>
        <Description>Zero-dependency, AOT-compatible native OS keyring access for .NET (Linux libsecret, Windows Credential Manager, macOS/iOS Keychain, Android Keystore).</Description>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>keyring;keychain;libsecret;credentials;secrets;security;avalonia;maui;aot</PackageTags>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>
    
