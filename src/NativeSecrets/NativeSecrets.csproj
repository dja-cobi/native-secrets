<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks Condition="'$(EnableAndroid)' == 'true'">net10.0;net10.0-android</TargetFrameworks>
        <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">net10.0;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
        <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx')) AND '$(EnableAndroid)' == 'true'">net10.0;net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>

        <!-- Если множественный TargetFrameworks не задан, используем одиночный TargetFramework -->
        <TargetFramework Condition="'$(TargetFrameworks)' == ''">net10.0</TargetFramework>

        <!-- Основные настройки проекта -->
        <RootNamespace>NativeSecrets</RootNamespace>
        <AssemblyName>NativeSecrets</AssemblyName>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

        <!-- Совместимость с NativeAOT и Trimming (без PublishAot, так как это библиотека) -->
        <IsAotCompatible>true</IsAotCompatible>
        <IsTrimmable>true</IsTrimmable>
        <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
        <EnableAotAnalyzer>true</EnableAotAnalyzer>
        <InvariantGlobalization>true</InvariantGlobalization>

        <!-- Подавляем предупреждения о платформенно-зависимых API (вы проверяете ОС в рантайме) -->
        <NoWarn>$(NoWarn);CA1416</NoWarn>
    </PropertyGroup>

    <!-- Настройки для Windows -->
    <PropertyGroup Condition="$(TargetFramework.Contains('-windows'))">
        <UseWindowsForms>false</UseWindowsForms>
        <UseWPF>false</UseWPF>
    </PropertyGroup>

    <!-- Настройки для Android -->
    <PropertyGroup Condition="$(TargetFramework.Contains('-android'))">
        <SupportedOSPlatformVersion>23.0</SupportedOSPlatformVersion>
        <OutputType>Library</OutputType>
    </PropertyGroup>

    <!-- Настройки для iOS -->
    <PropertyGroup Condition="$(TargetFramework.Contains('-ios'))">
        <SupportedOSPlatformVersion>12.2</SupportedOSPlatformVersion>
        <OutputType>Library</OutputType>
    </PropertyGroup>

    <!-- Настройки для Mac Catalyst -->
    <PropertyGroup Condition="$(TargetFramework.Contains('-maccatalyst'))">
        <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
        <OutputType>Library</OutputType>
    </PropertyGroup>

    <!-- Метаданные для публикации NuGet-пакета -->
    <PropertyGroup>
        <PackageId>NativeSecrets</PackageId>
        <Version>1.0.0</Version>
        <Authors>djacobi</Authors>
        <Description>Zero-dependency, AOT-compatible native OS keyring access for .NET (Linux libsecret, Windows Credential Manager, macOS/iOS Keychain, Android Keystore).</Description>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>keyring;keychain;libsecret;credentials;secrets;security;avalonia;maui;aot</PackageTags>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" PrivateAssets="all"/>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.1"/>
        <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0"/>
    </ItemGroup>

    <!-- Включаем IosKeychain.cs только для iOS и MacCatalyst (независимо от директив #if) -->
    <ItemGroup Condition="!$(TargetFramework.Contains('-ios')) AND !$(TargetFramework.Contains('-maccatalyst'))">
        <Compile Remove="**\IosKeychain.cs" />
    </ItemGroup>

    <!-- Включаем AndroidKeychain.cs только для Android -->
    <ItemGroup Condition="!$(TargetFramework.Contains('-android'))">
        <Compile Remove="**\AndroidKeychain.cs" />
    </ItemGroup>

</Project>


